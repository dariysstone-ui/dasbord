{
  "version": 2,
  "builds": [
    { "src": "index.html", "use": "@vercel/static" },
    { "src": "report.html", "use": "@vercel/static" },
    { "src": "sms.html", "use": "@vercel/static" },
    { "src": "metrics.html", "use": "@vercel/static" },
    { "src": "generate_pptx.py", "use": "@vercel/static" },
    { "src": "api/index.js", "use": "@vercel/node" },
    { "src": "api/pptx.js", "use": "@vercel/node" }
  ],
  "routes": [
    { "src": "/api/pptx", "dest": "/api/pptx.js" },
    { "src": "/api", "dest": "/api/index.js" },
    { "src": "/report", "dest": "/report.html" },
    { "src": "/sms", "dest": "/sms.html" },
    { "src": "/metrics", "dest": "/metrics.html" },
    { "src": "/(.*)", "dest": "/$1" }
  ]
}
